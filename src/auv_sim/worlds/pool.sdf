<?xml version="1.0"?>
<sdf version="1.9">
 <world name="pool">
  <gravity>0 0 0</gravity>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.05 0.25 0.45 1</background></scene>
  <light type="directional" name="sun"><direction>0 0 -1</direction><diffuse>1 1 1 1</diffuse></light>

  <!-- Buoys: red is 5 m ahead, green/yellow 4.5 m apart (see arena drawing). Adjust to taste. -->
  <model name="buoy_red"><static>true</static><pose>0 5 -2 0 0 0</pose>
    <link name="l">
      <collision name="c"><geometry><sphere><radius>0.2</radius></sphere></geometry></collision>
      <visual name="v"><geometry><sphere><radius>0.2</radius></sphere></geometry>
      <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual></link></model>
  <model name="buoy_green"><static>true</static><pose>-2.25 8 -2 0 0 0</pose>
    <link name="l">
      <collision name="c"><geometry><sphere><radius>0.2</radius></sphere></geometry></collision>
      <visual name="v"><geometry><sphere><radius>0.2</radius></sphere></geometry>
      <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual></link></model>
  <model name="buoy_yellow"><static>true</static><pose>2.25 8 -2 0 0 0</pose>
    <link name="l">
      <collision name="c"><geometry><sphere><radius>0.2</radius></sphere></geometry></collision>
      <visual name="v"><geometry><sphere><radius>0.2</radius></sphere></geometry>
      <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual></link></model>

  <!-- AUV starts at origin, yaw +90 deg so it faces +y toward the buoys -->
  <model name="auv"><pose>0 0 -2 0 0 1.5708</pose>
    <link name="base">
      <inertial><mass>10</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
      <visual name="v"><geometry><box><size>0.6 0.4 0.2</size></box></geometry></visual>
      <collision name="c"><geometry><box><size>0.6 0.4 0.2</size></box></geometry></collision>
      <sensor name="cam" type="camera">
        <pose>0.31 0 0 0 0 0</pose><update_rate>15</update_rate><topic>camera/image</topic>
        <always_on>1</always_on>
        <camera><horizontal_fov>1.2</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>20</far></clip></camera>
      </sensor>
    </link>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
  </model>
 </world>
</sdf>
