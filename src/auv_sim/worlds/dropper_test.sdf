<?xml version="1.0"?>
<sdf version="1.9">
  <world name="dropper_test">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>3.0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <enable>auv</enable>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.02 0.04 0.06 1</background>
    </scene>
    <light type="directional" name="test_light">
      <pose>0 0 5 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.2 0.1 -1</direction>
    </light>

    <model name="dark_test_floor">
      <static>true</static>
      <link name="floor">
        <collision name="collision">
          <pose>0 0 -0.1 0 0 0</pose>
          <geometry><box><size>12 12 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.1 0 0 0</pose>
          <geometry><box><size>12 12 0.2</size></box></geometry>
          <material>
            <ambient>0.02 0.04 0.06 1</ambient>
            <diffuse>0.02 0.04 0.06 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="bin_X">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="bin">
        <collision name="bottom_collision">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><box><size>0.62 0.62 0.04</size></box></geometry>
        </collision>
        <collision name="front_wall_collision">
          <pose>0 0.285 0.11 0 0 0</pose>
          <geometry><box><size>0.62 0.05 0.18</size></box></geometry>
        </collision>
        <collision name="back_wall_collision">
          <pose>0 -0.285 0.11 0 0 0</pose>
          <geometry><box><size>0.62 0.05 0.18</size></box></geometry>
        </collision>
        <collision name="left_wall_collision">
          <pose>-0.285 0 0.11 0 0 0</pose>
          <geometry><box><size>0.05 0.62 0.18</size></box></geometry>
        </collision>
        <collision name="right_wall_collision">
          <pose>0.285 0 0.11 0 0 0</pose>
          <geometry><box><size>0.05 0.62 0.18</size></box></geometry>
        </collision>
        <visual name="white_detection_surface">
          <pose>0 0 0.041 0 0 0</pose>
          <geometry><box><size>0.42 0.42 0.002</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
        <visual name="x_marker_forward">
          <pose>0 0 0.045 0 0 0.785398</pose>
          <geometry><box><size>0.28 0.035 0.006</size></box></geometry>
          <material>
            <ambient>0.9 0.02 0.02 1</ambient>
            <diffuse>0.9 0.02 0.02 1</diffuse>
          </material>
        </visual>
        <visual name="x_marker_backward">
          <pose>0 0 0.045 0 0 -0.785398</pose>
          <geometry><box><size>0.28 0.035 0.006</size></box></geometry>
          <material>
            <ambient>0.9 0.02 0.02 1</ambient>
            <diffuse>0.9 0.02 0.02 1</diffuse>
          </material>
        </visual>
        <visual name="front_wall">
          <pose>0 0.285 0.11 0 0 0</pose>
          <geometry><box><size>0.62 0.05 0.18</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="back_wall">
          <pose>0 -0.285 0.11 0 0 0</pose>
          <geometry><box><size>0.62 0.05 0.18</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="left_wall">
          <pose>-0.285 0 0.11 0 0 0</pose>
          <geometry><box><size>0.05 0.62 0.18</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="right_wall">
          <pose>0.285 0 0.11 0 0 0</pose>
          <geometry><box><size>0.05 0.62 0.18</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="bin_O">
      <static>true</static>
      <pose>0.64 0 0 0 0 0</pose>
      <link name="bin">
        <collision name="bottom_collision">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><box><size>0.62 0.62 0.04</size></box></geometry>
        </collision>
        <collision name="front_wall_collision">
          <pose>0 0.285 0.11 0 0 0</pose>
          <geometry><box><size>0.62 0.05 0.18</size></box></geometry>
        </collision>
        <collision name="back_wall_collision">
          <pose>0 -0.285 0.11 0 0 0</pose>
          <geometry><box><size>0.62 0.05 0.18</size></box></geometry>
        </collision>
        <collision name="left_wall_collision">
          <pose>-0.285 0 0.11 0 0 0</pose>
          <geometry><box><size>0.05 0.62 0.18</size></box></geometry>
        </collision>
        <collision name="right_wall_collision">
          <pose>0.285 0 0.11 0 0 0</pose>
          <geometry><box><size>0.05 0.62 0.18</size></box></geometry>
        </collision>
        <visual name="white_detection_surface">
          <pose>0 0 0.041 0 0 0</pose>
          <geometry><box><size>0.42 0.42 0.002</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
        <visual name="o_marker_top">
          <pose>0 0.11 0.045 0 0 0</pose>
          <geometry><box><size>0.22 0.035 0.006</size></box></geometry>
          <material>
            <ambient>0.9 0.02 0.02 1</ambient>
            <diffuse>0.9 0.02 0.02 1</diffuse>
          </material>
        </visual>
        <visual name="o_marker_bottom">
          <pose>0 -0.11 0.045 0 0 0</pose>
          <geometry><box><size>0.22 0.035 0.006</size></box></geometry>
          <material>
            <ambient>0.9 0.02 0.02 1</ambient>
            <diffuse>0.9 0.02 0.02 1</diffuse>
          </material>
        </visual>
        <visual name="o_marker_left">
          <pose>-0.11 0 0.045 0 0 0</pose>
          <geometry><box><size>0.035 0.22 0.006</size></box></geometry>
          <material>
            <ambient>0.9 0.02 0.02 1</ambient>
            <diffuse>0.9 0.02 0.02 1</diffuse>
          </material>
        </visual>
        <visual name="o_marker_right">
          <pose>0.11 0 0.045 0 0 0</pose>
          <geometry><box><size>0.035 0.22 0.006</size></box></geometry>
          <material>
            <ambient>0.9 0.02 0.02 1</ambient>
            <diffuse>0.9 0.02 0.02 1</diffuse>
          </material>
        </visual>
        <visual name="front_wall">
          <pose>0 0.285 0.11 0 0 0</pose>
          <geometry><box><size>0.62 0.05 0.18</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="back_wall">
          <pose>0 -0.285 0.11 0 0 0</pose>
          <geometry><box><size>0.62 0.05 0.18</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="left_wall">
          <pose>-0.285 0 0.11 0 0 0</pose>
          <geometry><box><size>0.05 0.62 0.18</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="right_wall">
          <pose>0.285 0 0.11 0 0 0</pose>
          <geometry><box><size>0.05 0.62 0.18</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="auv">
      <pose>1 0 2 0 0 0</pose>
      <link name="base">
        <inertial>
          <mass>60</mass>
          <inertia>
            <ixx>1.45</ixx><iyy>2.0</iyy><izz>3.05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="hull_collision">
          <geometry><box><size>0.6 0.5 0.2</size></box></geometry>
        </collision>
        <visual name="hull_visual">
          <geometry><box><size>0.6 0.5 0.2</size></box></geometry>
          <material>
            <ambient>0.12 0.16 0.2 1</ambient>
            <diffuse>0.12 0.16 0.2 1</diffuse>
          </material>
        </visual>
        <sensor name="downward_camera" type="camera">
          <pose>0 0 -0.12 0 1.570796 0</pose>
          <update_rate>15</update_rate>
          <topic>/dropper/camera/image</topic>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.05</near><far>10</far></clip>
          </camera>
        </sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>base</parent_link>
        <child_model>drop_payload</child_model>
        <child_link>payload</child_link>
        <detach_topic>/dropper/payload/detach</detach_topic>
        <attach_topic>/dropper/payload/attach</attach_topic>
      </plugin>
    </model>

    <model name="drop_payload">
      <pose relative_to="auv">0.2 0 -0.24 0 0 0</pose>
      <link name="payload">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="ball_collision">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
        </collision>
        <visual name="ball_visual">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material>
            <ambient>0.05 0.15 0.9 1</ambient>
            <diffuse>0.05 0.15 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <plugin filename="gz-sim-triggered-publisher-system" name="gz::sim::systems::TriggeredPublisher">
      <input type="gz.msgs.Boolean" topic="/actuators/gripper_open">
        <match>data: true</match>
      </input>
      <output type="gz.msgs.Empty" topic="/dropper/payload/detach"/>
    </plugin>
  </world>
</sdf>
